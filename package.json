{
  "name": "lalia",
  "version": "0.1.1",
  "description": "Audio-reactive orbs for voice AI agents: a WebGL voice visualizer for React and plain JavaScript. Works with ElevenLabs, OpenAI Realtime, Gemini Live and LiveKit.",
  "license": "MIT",
  "author": "Marcus (https://offbrand.design)",
  "keywords": [
    "voice-ai",
    "ai-agent",
    "voice-agent",
    "conversational-ai",
    "voice-assistant",
    "orb",
    "audio-visualizer",
    "voice-visualizer",
    "audio-reactive",
    "webgl",
    "shader",
    "react",
    "elevenlabs",
    "openai-realtime",
    "gemini-live",
    "livekit",
    "pipecat",
    "vapi",
    "speech",
    "voice-ui"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "DOCS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./variants": {
      "types": "./dist/variants/index.d.ts",
      "default": "./dist/variants/index.js"
    },
    "./schemes": {
      "types": "./dist/schemes.d.ts",
      "default": "./dist/schemes.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./adapters/elevenlabs": {
      "types": "./dist/adapters/elevenlabs.d.ts",
      "default": "./dist/adapters/elevenlabs.js"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai.d.ts",
      "default": "./dist/adapters/openai.js"
    },
    "./adapters/gemini": {
      "types": "./dist/adapters/gemini.d.ts",
      "default": "./dist/adapters/gemini.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test test/"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbenhard/lalia.git"
  },
  "homepage": "https://lalia.offbrand.design",
  "bugs": {
    "url": "https://github.com/mbenhard/lalia/issues"
  }
}
